# Supabase project (frontend-safe values only — the anon key is public by design;
# security is enforced by Row Level Security).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# NEVER put the OpenAI API key or the Supabase service-role key here.
# The OpenAI key lives only as a Supabase Edge Function secret:
#   supabase secrets set OPENAI_API_KEY
